# Copy to .env and edit. Every value has a safe default for offline single-school use.

# Server
PORT=3000
HOST=0.0.0.0

# Path to the SQLite database file (created automatically)
DB_PATH=./data/school.db

# Secret used to sign auth tokens. CHANGE THIS on any real installation.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-please

# Session lifetime in minutes (auto logout)
SESSION_MINUTES=480

# SMS gateway: "outbox" (default, offline queue only), "twilio", "orange", "mtn", "custom"
SMS_PROVIDER=outbox
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SCHOOL

# Mobile money: "manual" (default, record payments by hand) or provider keys
MOMO_MTN_API_KEY=
MOMO_ORANGE_API_KEY=

# Automatic backup interval in hours (0 disables). Backups go to ./data/backups
BACKUP_HOURS=24
